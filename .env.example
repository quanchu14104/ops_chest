# Sao chep thanh .env roi dien gia tri. File .env KHONG commit.

# ---- LLM: bat ky endpoint OpenAI-compatible ----
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1         LLM_MODEL=gpt-4o-mini
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1       LLM_MODEL=anthropic/claude-sonnet-4.5
# DeepSeek:    LLM_BASE_URL=https://api.deepseek.com/v1        LLM_MODEL=deepseek-chat
# Ollama:      LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_MODEL=qwen2.5:14b  (LLM_API_KEY de trong)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Mot so provider khong ho tro stream + tool calls cung luc -> dat false
LLM_STREAM=true
# Dem token moi luot (ghi vao audit). Dat false neu provider bao loi "stream_options"
LLM_STREAM_USAGE=true

# ---- LLM phu (fallback, tuy chon) ----
# Dung khi LLM chinh loi 429 (het han muc), 5xx, mat ket noi... TRUOC khi tra loi duoc chu nao.
# LLM chinh bi "nghi" 2 phut (het han muc/phut) hoac 15 phut (het han muc/ngay) roi moi thu lai.
# Gemini: LLM_BASE_URL_FALLBACK=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL_FALLBACK=
LLM_API_KEY_FALLBACK=
LLM_MODEL_FALLBACK=

# ---- Ngay nghiep vu ----
# De trong = ngay that. Dat co dinh (vd 2026-11-07) de demo on dinh sau khi seed.
SIM_TODAY=

# ---- Bao mat ----
SECRET_KEY=doi-chuoi-nay-thanh-chuoi-ngau-nhien

# ---- Cua hang ----
STORE_NAME=SenaMart
STORE_ADDRESS=14 Bà Triệu
STORE_PHONE=0987654321

# Tai khoan demo do seed tao (chi moi truong gia lap):
#   quanly / quanly123     (Store Manager - duoc duyet de xuat)
#   nhanvien / nhanvien123 (nhan vien - xem, chat, nhan hang)
